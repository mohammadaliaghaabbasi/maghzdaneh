# Port for the Node.js server (AI Studio requires 3000)
PORT=3000

# Optional: Pre-configure admin credentials via environment variables in production.
# When unset, admin credentials are verified against the server-side scrypt hash
# created via the first-run setup form on /admin.html.
MAGHZDANEH_ADMIN_USER=
MAGHZDANEH_ADMIN_PASS=

# Optional: External SMS gateway credentials (e.g. Kavenegar / MeliPayamak) for live OTP & price alerts.
# When unset, SMS/OTP runs in interactive demo mode.
SMS_API_KEY=
SMS_GATEWAY_URL=

# Optional: Iranian Payment Gateway (ZarinPal / Zibal / Shaparak) Merchant ID.
# When unset, checkout uses the built-in Shaparak Demo Sandbox gateway.
ZARINPAL_MERCHANT_ID=

# Optional: Post / Tipax live shipping & parcel tracking API key.
# When unset, shipping calculation and parcel tracking run in demo mode.
POST_API_KEY=

# Optional: Web Push VAPID keys for live PWA push notifications.
# When unset, browser notifications run in local PWA demo mode.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
