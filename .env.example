# Port for the Node.js server (AI Studio requires 3000)
PORT=3000

# Optional: Pre-configure admin credentials via environment variables in production.
# When unset, the first visit to /admin.html offers a secure one-time setup form.
# MAGHZDANEH_ADMIN_USER=your_admin_username
# MAGHZDANEH_ADMIN_PASS=your_strong_password_min_8_chars

# Optional: Secret key for signing HttpOnly session tokens (auto-generated on disk if unset)
# SESSION_SECRET=your_64_char_random_hex_secret

# Optional: External SMS gateway credentials for production mobile OTP delivery.
# When unset, OTP codes run in interactive preview mode.
# SMS_API_KEY=your_sms_provider_api_key
# SMS_GATEWAY_URL=https://api.your-sms-provider.example/send

